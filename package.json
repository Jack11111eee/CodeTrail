{
  "name": "openwiki",
  "version": "0.7.2",
  "description": "Codetrail: a local learning system built on a pinned fork of OpenWiki, the DeepAgents documentation agent that generates and maintains a wiki for a codebase.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "openwiki": "./dist/cli/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langchain-ai/openwiki.git"
  },
  "bugs": {
    "url": "https://github.com/langchain-ai/openwiki/issues"
  },
  "homepage": "https://github.com/langchain-ai/openwiki#readme",
  "files": [
    "dist",
    "!dist/learning/testing",
    "integrations",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "ai",
    "agents",
    "documentation",
    "wiki",
    "deepagents",
    "langchain",
    "cli"
  ],
  "pi": {
    "extensions": [
      "./dist/integrations/pi/openwiki.js"
    ],
    "skills": [
      "./integrations/openwiki"
    ]
  },
  "scripts": {
    "accept": "node scripts/with-node.mjs scripts/accept.mjs",
    "backup": "node scripts/with-node.mjs scripts/backup.mjs",
    "build": "node scripts/with-node.mjs node_modules/typescript7/bin/tsc -p tsconfig.json && node scripts/with-node.mjs node_modules/typescript7/bin/tsc -p tsconfig.client.json && node scripts/with-node.mjs scripts/copy-visualize-assets.cjs && node scripts/with-node.mjs scripts/copy-learning-assets.cjs",
    "changeset:version": "changeset version",
    "clean": "node scripts/with-node.mjs -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "coverage": "node scripts/with-node.mjs node_modules/vitest/vitest.mjs run --coverage",
    "dev": "node scripts/with-node.mjs node_modules/tsx/dist/cli.mjs src/cli/cli.tsx",
    "env:check": "node scripts/with-node.mjs scripts/check-env.mjs",
    "eval:ledger": "node scripts/with-node.mjs node_modules/tsx/dist/cli.mjs evals/ledger/run.ts",
    "eval:ledger:reevaluate": "node scripts/with-node.mjs node_modules/tsx/dist/cli.mjs evals/ledger/reevaluate.ts",
    "eval:ledger:typecheck": "node scripts/with-node.mjs node_modules/typescript7/bin/tsc --noEmit -p evals/ledger/tsconfig.json",
    "fixtures": "node scripts/with-node.mjs scripts/make-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gc": "node scripts/with-node.mjs scripts/gc.mjs",
    "integrations:dev": "pnpm run build && node scripts/with-node.mjs scripts/install-local-integration.mjs",
    "licenses": "node scripts/with-node.mjs scripts/licenses.mjs",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "openwiki": "node scripts/with-node.mjs dist/cli/cli.js",
    "phase:check": "node scripts/with-node.mjs scripts/phase-check.mjs",
    "postbuild": "node scripts/with-node.mjs -e \"require('fs').chmodSync('dist/cli/cli.js', 0o755)\"",
    "prebuild": "pnpm run clean",
    "prepack": "pnpm run build",
    "provenance:check": "node scripts/with-node.mjs scripts/check-provenance.mjs",
    "release": "pnpm run stamp:channel && pnpm run build && changeset publish",
    "restore": "node scripts/with-node.mjs scripts/restore.mjs",
    "smoke": "node scripts/with-node.mjs scripts/smoke.mjs",
    "stamp:channel": "node scripts/with-node.mjs scripts/stamp-build-channel.cjs",
    "start": "node scripts/with-node.mjs dist/cli/cli.js",
    "start:learning": "node scripts/with-node.mjs dist/learning/api/cli.js",
    "test": "pnpm run typecheck && pnpm run build && pnpm run coverage",
    "test:learning": "node scripts/with-node.mjs node_modules/vitest/vitest.mjs run --config vitest.learning.config.ts",
    "test:upstream": "node scripts/with-node.mjs node_modules/vitest/vitest.mjs run --config vitest.config.ts --exclude 'test/learning/**'",
    "typecheck": "node scripts/with-node.mjs node_modules/typescript7/bin/tsc --noEmit -p tsconfig.json && node scripts/with-node.mjs node_modules/typescript7/bin/tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "^1.1.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1120.0",
    "@azure/identity": "^4.14.1",
    "@langchain/anthropic": "^1.5.8",
    "@langchain/aws": "^1.4.4",
    "@langchain/core": "^1.2.9",
    "@langchain/google": "^0.2.3",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/openai": "^1.5.11",
    "@langchain/openrouter": "^0.4.10",
    "@langchain/protocol": "^0.0.19",
    "@langchain/tavily": "1.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ci-info": "^4.4.0",
    "cron-parser": "5.10.1",
    "cronstrue": "3.27.0",
    "deepagents": "1.13.2",
    "google-auth-library": "^11.0.2",
    "ink": "~8.0.0",
    "jsonc-parser": "^3.3.1",
    "langchain": "^1.5.10",
    "langsmith": "^0.10.5",
    "marked": "^18.0.11",
    "posthog-node": "^5.51.4",
    "react": "^19.3.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "jsdom": "^29.1.1 || ^30.0.0",
    "mermaid": "^11.16.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.9.1",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^30.0.1",
    "mermaid": "^12.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.68.0",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.25.0"
}
